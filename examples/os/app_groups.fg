// groups — daily-ten 19 Nov 2026 (OS track).
// Simulates `groups jayant`: member of wheel, dev, audio.
// Prints each group, then the group count (3).
fn main() {
    let groups: [str] = ["wheel", "dev", "audio"];
    let mut i: int = 0;
    while i < len(groups) {
        println(groups[i]);
        i = i + 1;
    }
    println(3);
}

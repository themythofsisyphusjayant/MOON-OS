// id — daily-ten 14 Nov 2026 (OS track).
// Simulates `id jayant` over a fixed user table: looks "jayant"
// up by name scan, then prints uid, gid, group list and the
// group count (3). uid 1000, gid 1000, groups 1000,27,100.
fn main() {
    let users: [str] = ["root", "jayant"];
    let uids: [int] = [0, 1000];
    let gids: [int] = [0, 1000];
    let groups: [str] = ["0", "1000,27,100"];
    let ngroups: [int] = [1, 3];
    let mut idx: int = -1;
    let mut i: int = 0;
    while i < len(users) {
        if users[i] == "jayant" {
            idx = i;
        }
        i = i + 1;
    }
    print("uid=");
    println(uids[idx]);
    print("gid=");
    println(gids[idx]);
    println("groups=" + groups[idx]);
    println(ngroups[idx]);
}

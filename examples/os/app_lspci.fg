// lspci — daily-ten 20 Nov 2026 (OS track).
// Simulates `lspci`: 3 PCI devices with class codes
// 512 (network, 0x0200), 768 (display, 0x0300),
// 256 (storage, 0x0100). Prints each class code,
// then the device count (3).
fn main() {
    let classes: [int] = [512, 768, 256];
    let mut i: int = 0;
    while i < len(classes) {
        println(classes[i]);
        i = i + 1;
    }
    println(3);
}

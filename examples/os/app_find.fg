// find — daily-ten 18 Nov 2026 (OS track).
// Simulates `find . -name todo.txt` over four files:
// notes.txt, report.md, todo.txt, data.csv. The match
// is todo.txt at index 2. Prints the found name, its
// index (2), then the match count (1).
fn main() {
    let files: [str] = ["notes.txt", "report.md", "todo.txt", "data.csv"];
    let mut i: int = 0;
    let mut found: int = -1;
    while i < len(files) {
        if files[i] == "todo.txt" {
            found = i;
        }
        i = i + 1;
    }
    println(files[found]);
    println(found);
    println(1);
}

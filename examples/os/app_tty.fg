// tty — daily-ten 15 Nov 2026 (OS track).
// Simulates `tty` over a fixed terminal table: /dev/tty1 is
// the current terminal (index 0); /dev/pts/0 is the other
// session. Prints the current tty, its index, then the
// terminal count (2).
fn main() {
    let ttys: [str] = ["/dev/tty1", "/dev/pts/0"];
    println(ttys[0]);
    println(0);
    println(len(ttys));
}

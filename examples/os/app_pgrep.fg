// pgrep — daily-ten 28 Nov 2026 (OS track).
// Fixed process table of 5 processes: pid 1 "init", pid 42 "qasida",
// pid 137 "shell", pid 256 "qasida-worker", pid 512 "cron".
// Fixed pattern "qasida" (substring match). Matches, in table order:
// pid 42 ("qasida") and pid 256 ("qasida-worker"); count is 2.
// Expected stdout (hand-computed):
// 42
// 256
// 2
fn contains(hay: str, needle: str) -> bool {
    if len(needle) == 0 {
        return true;
    }
    let mut i: int = 0;
    while i + len(needle) <= len(hay) {
        if substr(hay, i, len(needle)) == needle {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn main() {
    let pids: [int] = [1, 42, 137, 256, 512];
    let names: [str] = ["init", "qasida", "shell", "qasida-worker", "cron"];
    let mut found: int = 0;
    let mut i: int = 0;
    while i < len(pids) {
        if contains(names[i], "qasida") {
            println(pids[i]);
            found = found + 1;
        }
        i = i + 1;
    }
    println(found);
}

// dd — daily-ten 19 Nov 2026 (OS track).
// Simulates `dd if=in of=out bs=512 count=3`: 3 blocks
// of 512 bytes copied, 1536 bytes total. Prints records
// in (3), records out (3), bytes (1536), then the value
// count (3).
fn main() {
    let blocks: int = 3;
    let bs: int = 512;
    println(blocks);
    println(blocks);
    println(blocks * bs);
    println(3);
}

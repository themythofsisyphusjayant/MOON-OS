// dirname — daily-ten 14 Nov 2026 (OS track).
// Simulates `dirname` on four fixed paths: strips trailing
// slashes, then returns the text before the last '/' ('.' when
// there is no slash, '/' when the slash is the root).
// /home/jayant/notes.txt -> /home/jayant; /etc/hosts -> /etc;
// README.md -> .; /var/log/ -> /var. Then the count (4).
fn dirname(p: str) -> str {
    let mut s: str = p;
    while len(s) > 0 && substr(s, len(s) - 1, 1) == "/" {
        s = substr(s, 0, len(s) - 1);
    }
    let mut last: int = -1;
    let mut i: int = 0;
    while i < len(s) {
        if substr(s, i, 1) == "/" {
            last = i;
        }
        i = i + 1;
    }
    if last < 0 {
        return ".";
    }
    if last == 0 {
        return "/";
    }
    return substr(s, 0, last);
}

fn main() {
    let paths: [str] = ["/home/jayant/notes.txt", "/etc/hosts", "README.md", "/var/log/"];
    let mut i: int = 0;
    while i < len(paths) {
        println(dirname(paths[i]));
        i = i + 1;
    }
    println(len(paths));
}

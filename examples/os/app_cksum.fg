// cksum — daily-ten 16 Nov 2026 (OS track).
// Simulates `cksum` (byte-sum checksum) over two fixed
// byte strings: "Hi!" [72, 105, 33] sums to 210;
// "OK" [79, 75] sums to 154. Prints each sum, then the
// grand total (210 + 154 = 364) and the string count (2).
fn main() {
    let b1: [int] = [72, 105, 33];
    let b2: [int] = [79, 75];
    let mut s1: int = 0;
    let mut i: int = 0;
    while i < len(b1) {
        s1 = s1 + b1[i];
        i = i + 1;
    }
    let mut s2: int = 0;
    let mut j: int = 0;
    while j < len(b2) {
        s2 = s2 + b2[j];
        j = j + 1;
    }
    println(s1);
    println(s2);
    println(s1 + s2);
    println(2);
}

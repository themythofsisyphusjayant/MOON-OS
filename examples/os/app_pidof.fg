// pidof — daily-ten 28 Nov 2026 (OS track).
// Fixed process table (pid, name), in table order:
//   42 "qasida", 2 "sh", 137 "qasida", 10 "http", 256 "qasida".
// Target name is "qasida"; it appears 3 times, so the expected stdout is:
//   42
//   137
//   256
//   3

fn main() {
    let pids: [int] = [42, 2, 137, 10, 256];
    let names: [str] = ["qasida", "sh", "qasida", "http", "qasida"];
    let target: str = "qasida";
    let mut count: int = 0;
    let mut i: int = 0;
    while i < len(pids) {
        if names[i] == target {
            println(pids[i]);
            count = count + 1;
        }
        i = i + 1;
    }
    println(count);
}

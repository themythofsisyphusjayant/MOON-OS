// nohup — daily-ten 19 Nov 2026 (OS track).
// Simulates `nohup cmd &`: the command runs with pid
// 1234, SIGHUP ignored (1), and exits 0. Prints the pid,
// the ignored flag, the exit code, then the value count (3).
fn main() {
    let pid: int = 1234;
    let ignored: int = 1;
    let code: int = 0;
    println(pid);
    println(ignored);
    println(code);
    println(3);
}

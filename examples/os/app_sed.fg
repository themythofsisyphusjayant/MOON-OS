// sed — daily-ten 16 Nov 2026 (OS track).
// Simulates `sed 's/foo/bar/g'` over two fixed lines:
// "foo bar foo" -> "bar bar bar" (2 substitutions);
// "no match here" -> unchanged (0 substitutions).
// Prints the result and the substitution count per line,
// then the line count (2).
fn count_occ(s: str, pat: str) -> int {
    let mut n: int = 0;
    let mut i: int = 0;
    while i + len(pat) <= len(s) {
        if substr(s, i, len(pat)) == pat {
            n = n + 1;
            i = i + len(pat);
        } else {
            i = i + 1;
        }
    }
    return n;
}

fn subst(s: str, pat: str, rep: str) -> str {
    let mut out: str = "";
    let mut i: int = 0;
    while i < len(s) {
        if i + len(pat) <= len(s) {
            if substr(s, i, len(pat)) == pat {
                out = out + rep;
                i = i + len(pat);
            } else {
                out = out + substr(s, i, 1);
                i = i + 1;
            }
        } else {
            out = out + substr(s, i, 1);
            i = i + 1;
        }
    }
    return out;
}

fn main() {
    let lines: [str] = ["foo bar foo", "no match here"];
    let mut i: int = 0;
    while i < len(lines) {
        println(subst(lines[i], "foo", "bar"));
        println(count_occ(lines[i], "foo"));
        i = i + 1;
    }
    println(len(lines));
}

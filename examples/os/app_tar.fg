// tar — daily-ten 19 Nov 2026 (OS track).
// Simulates `tar cf out.tar a b c` with file sizes 100,
// 200, 300: archive total 600 bytes over 3 files. Prints
// each size, the total (600), then the file count (3).
fn main() {
    let sizes: [int] = [100, 200, 300];
    let mut total: int = 0;
    let mut i: int = 0;
    while i < len(sizes) {
        println(sizes[i]);
        total = total + sizes[i];
        i = i + 1;
    }
    println(total);
    println(3);
}

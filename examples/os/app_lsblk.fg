// lsblk — daily-ten 20 Nov 2026 (OS track).
// Simulates `lsblk`: 3 block devices of 512, 1024,
// 2048 MB. Prints each size, the total (3584 MB),
// then the device count (3).
fn main() {
    let sizes: [int] = [512, 1024, 2048];
    let mut total: int = 0;
    let mut i: int = 0;
    while i < len(sizes) {
        println(sizes[i]);
        total = total + sizes[i];
        i = i + 1;
    }
    println(total);
    println(3);
}

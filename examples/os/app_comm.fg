// comm — daily-ten 13 Nov 2026 (OS track).
// Simulates `comm` on two fixed sorted lists: A is apple,
// fig, kiwi, pear; B is banana, fig, kiwi, plum. Prints
// the lines common to both (fig, kiwi) via a two-pointer
// merge using the same rank-based lexicographic compare
// as app_sort, then the common count (2).
fn rank(ch: str) -> int {
    let alpha: str = "abcdefghijklmnopqrstuvwxyz";
    let mut i: int = 0;
    while i < len(alpha) {
        if substr(alpha, i, 1) == ch {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn cmp_str(a: str, b: str) -> int {
    let mut i: int = 0;
    while i < len(a) {
        if i >= len(b) {
            return 1;
        }
        let ra: int = rank(substr(a, i, 1));
        let rb: int = rank(substr(b, i, 1));
        if ra < rb {
            return -1;
        }
        if ra > rb {
            return 1;
        }
        i = i + 1;
    }
    if len(a) < len(b) {
        return -1;
    }
    if len(a) > len(b) {
        return 1;
    }
    return 0;
}

fn main() {
    let a: [str] = ["apple", "fig", "kiwi", "pear"];
    let b: [str] = ["banana", "fig", "kiwi", "plum"];
    let mut i: int = 0;
    let mut j: int = 0;
    let mut common: int = 0;
    while i < len(a) {
        if j >= len(b) {
            i = i + 1;
        } else {
            let c: int = cmp_str(a[i], b[j]);
            if c == 0 {
                println(a[i]);
                common = common + 1;
                i = i + 1;
                j = j + 1;
            } else {
                if c < 0 {
                    i = i + 1;
                } else {
                    j = j + 1;
                }
            }
        }
    }
    println(common);
}
